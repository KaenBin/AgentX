# -----------------------------------------------------------------------------
# AgentX configuration. Copy to `.env` and fill in. Never commit `.env`.
# All variables are read by src/core/config.py via pydantic-settings and are
# prefixed with AGENTX_.
# -----------------------------------------------------------------------------

# LLM provider: one of "openai", "anthropic", "mock"
AGENTX_LLM_PROVIDER=mock

# API key for the selected provider (leave blank when using the mock provider).
AGENTX_LLM_API_KEY=

# Default model name for the selected provider.
AGENTX_LLM_MODEL=gpt-4o-mini

# Sampling temperature (0.0 = deterministic, higher = more creative).
AGENTX_LLM_TEMPERATURE=0.2

# Safety rails for autonomous agent loops.
AGENTX_MAX_AGENT_STEPS=12
AGENTX_MAX_TOOL_CALLS=25

# Root directory the sandboxed file tools are allowed to touch.
AGENTX_SANDBOX_ROOT=./sandbox_workspace

# SQLite database used by the read-only db_queries tool.
AGENTX_DATABASE_URL=sqlite:///./sandbox_workspace/sme.db

# Logging: DEBUG | INFO | WARNING | ERROR, and "json" | "text" format.
AGENTX_LOG_LEVEL=INFO
AGENTX_LOG_FORMAT=text

# Locale defaults tuned for Singapore SMEs.
AGENTX_TIMEZONE=Asia/Singapore
AGENTX_CURRENCY=SGD
