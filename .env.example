# AgentX configuration — copy to `.env` and adjust.
# Scaffold placeholder: defaults will use an offline mock provider (no key).

# LLM provider: mock | openai | anthropic
AGENTX_LLM_PROVIDER=mock
# AGENTX_LLM_API_KEY=
# AGENTX_LLM_MODEL=

# Singapore-aware defaults
AGENTX_TIMEZONE=Asia/Singapore
AGENTX_CURRENCY=SGD

# Safety limits for autonomous loops
AGENTX_MAX_STEPS=10
AGENTX_MAX_TOOL_CALLS=25
