# Demo mode needs no credentials. Change to gateway to enable model calls.
AGENT_MODE=demo
# ollama: existing host model gateway; openclaw: OpenClaw Chat Completions API.
LLM_GATEWAY_PROTOCOL=ollama
# Base URL only: the selected protocol appends its endpoint path.
LLM_GATEWAY_URL=
# Host API key for ollama; Gateway bearer token for openclaw. Keep server-side.
LLM_GATEWAY_API_KEY=
# For OpenClaw, use the dedicated agent selector described in OPENCLAW.md.
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
